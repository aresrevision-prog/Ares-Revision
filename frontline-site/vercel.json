{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/functions/v1/:path*",
      "destination": "https://lakjmdyzuqrwcncxybcw.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/auth/v1/:path*",
      "destination": "https://lakjmdyzuqrwcncxybcw.supabase.co/auth/v1/:path*"
    }
  ]
}
